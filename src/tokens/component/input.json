			"border": {
				"default": { "$type": "color", "$value": "{input.semantic.outlined.border.default}" },
				"hover": { "$type": "color", "$value": "{input.semantic.outlined.border.hover}" },
				"focused": { "$type": "color", "$value": "{input.semantic.outlined.border.focused}" },
