					"text": { "$type": "color", "$value": "{chip.color.default.text}" },
					"deleteIcon": { "$type": "color", "$value": "{chip.color.default.deleteIcon}" }
				},
				"primary": {
					"background": { "$type": "color", "$value": "{chip.color.primary.background}" },
