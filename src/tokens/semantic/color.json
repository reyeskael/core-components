{
	"color": {
		"action": {
			"primary": {
				"default": { "$type": "color", "$value": "{color.green.500}" },
				"hover": { "$type": "color", "$value": "{color.green.400}" },
				"pressed": { "$type": "color", "$value": "{color.green.600}" }
			},
			"secondary": {
				"default": { "$type": "color", "$value": "{color.yellow.500}" },
				"hover": { "$type": "color", "$value": "{color.yellow.400}" },
				"pressed": { "$type": "color", "$value": "{color.yellow.600}" }
			}
		},
		"text": {
			"onPrimary": { "$type": "color", "$value": "{color.white}" },
			"onSecondary": { "$type": "color", "$value": "{color.black}" }
		},
		"surface": {
			"default": { "$type": "color", "$value": "{color.white}" }
		}
	}
}
